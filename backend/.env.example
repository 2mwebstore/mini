# Running the API on your computer (outside Docker):
#   1. from the repo root:  docker compose -f docker-compose.dev.yml up -d   (Redis + photo storage)
#   2. copy this file to backend/.env
#   3. in backend/:         go run ./cmd/api serve
# The API reads backend/.env, then the root .env (MySQL settings, JWT_SECRET).
# Variables set in your shell win. Docker never reads this file.

APP_ENV=development
HTTP_ADDR=127.0.0.1:8080

REDIS_URL=redis://127.0.0.1:6379/0

STORAGE_ENDPOINT=127.0.0.1:9090
STORAGE_ACCESS_KEY=dev
STORAGE_SECRET_KEY=dev-secret
STORAGE_BUCKET=attendance
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
