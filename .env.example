# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32
#
# Telegram (bot token, Mini App URL, group chats) is set in the admin panel:
# Settings → Telegram. Branches and branch admins: the Branches page.

# --- Security ---
# Signs admin panel sessions and encrypts the stored bot token. Changing it signs
# everyone out and means re-entering the bot token in Settings.
JWT_SECRET=replace_with_64_hex_chars

# --- MySQL ---
# Where the API's database is. With MAMP / MySQL on this computer (go run):
# MYSQL_HOST=127.0.0.1 and its port (3306). With Docker's bundled MySQL
# (docker compose up): MYSQL_HOST=database, MYSQL_PORT=3306, and MYSQL_USER must
# not be root (Docker's MySQL uses MYSQL_ROOT_PASSWORD for root).
MYSQL_HOST=database
MYSQL_PORT=3306
MYSQL_DATABASE=attendance
MYSQL_USER=attendance
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_me_too

# --- Redis ---
REDIS_PASSWORD=replace_me

# --- Photo storage (any S3-compatible bucket; Cloudflare R2 example in README) ---
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=attendance-minio
STORAGE_SECRET_KEY=replace_with_long_secret
STORAGE_BUCKET=attendance
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# --- Web ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Backups (daily mysqldump into ./backups) ---
TIMEZONE=Asia/Phnom_Penh
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30
