# Rename to ssl.conf and place certificates in ops/nginx/certs/ (fullchain.pem, privkey.pem).
# Then change default.conf's port-80 server to redirect: `location / { return 301 https://$host$request_uri; }`

server {
    listen 443 ssl;
    http2 on;
    server_name attendance.example.com;
    server_tokens off;
    client_max_body_size 2m;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location = /health { proxy_pass http://api/health; }
    location = /api/v1/auth/login { limit_req zone=login burst=5 nodelay; proxy_pass http://api; }
    location /api/ { proxy_pass http://api; proxy_read_timeout 120s; }
    location ~ ^/api/v1/app/attendance/check-(in|out)$ { client_max_body_size 9m; proxy_pass http://api; }
    location /app/ { proxy_pass http://miniapp; }
    location = /app { absolute_redirect off; return 301 /app/; }
    location /admin/ { proxy_pass http://admin; }
    location = /admin { absolute_redirect off; return 301 /admin/; }
    location = / { absolute_redirect off; return 302 /admin/; }
    location / { return 404; }
}
